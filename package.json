{
  "name": "kickr-studio",
  "productName": "KickrStudio",
  "version": "0.1.0",
  "description": "Desktop-Trainingsapp für den Wahoo Kickr: ERG-Workouts, Live-Daten, Strava-Upload, MCP-Schnittstelle für Claude",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"cross-env VITE_DEV=1 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "mcp": "node mcp/server.mjs",
    "icon": "node scripts/svg2png.mjs 16 32 64 128 256 512 && node scripts/make-ico.mjs",
    "build:app": "vite build && node scripts/package-app.mjs",
    "release": "npm run build:app && node scripts/install-release.mjs",
    "dist": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.kickrstudio.app",
    "productName": "KickrStudio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.1.0",
    "@google-cloud/storage": "^8.2.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uplot": "^1.6.31",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
